# OpenAI 설정
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 OpenAI 모델 ID (기본 권장값: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Supabase 설정
# Supabase 프로젝트 URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Key (sb_secret_... 또는 서비스 롤 키)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

